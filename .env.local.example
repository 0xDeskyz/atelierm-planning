# Copie ce fichier en .env.local et remplis les valeurs
# cp .env.local.example .env.local

# ── Supabase (projet B — SaaS) ─────────────────────────────────────────
# supabase.com/dashboard → ton projet → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://slvjxqkcijeartkcjlti.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # clé "anon public"
SUPABASE_SERVICE_ROLE_KEY=            # clé "service_role secret"

# ── Stripe ──────────────────────────────────────────────────────────────
# dashboard.stripe.com → Développeurs → Clés API
STRIPE_SECRET_KEY=                    # sk_test_...
STRIPE_WEBHOOK_SECRET=                # whsec_... (optionnel en local)

# ── Resend (emails) ─────────────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=                       # re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
